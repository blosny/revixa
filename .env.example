# -----------------------------------------------------------------------------
# Revixa 12-Factor App Environment Configuration Template
# Copy this file to '.env' for local development. Never commit '.env' to git!
# -----------------------------------------------------------------------------

# Environment Mode (development | staging | production)
ENVIRONMENT=development
DEBUG=true

# AI Provider Credentials (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama Fallback Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Database Connection (SQLite local path or Postgres URI)
DATABASE_URL=sqlite:///./revixa.db

# Security & JWT Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_string_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server & CORS Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
